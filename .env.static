# Static edition (`vite build --mode static`, docs/static-export.md): no database.
# Requests to /supabase/... are answered from /data/ files by src/staticData.ts.
# The key is a placeholder; nothing ever reaches a Supabase server.
VITE_STATIC=1
VITE_SUPABASE_URL=/supabase
VITE_SUPABASE_PUBLISHABLE_KEY=static-edition
# Public API links point at the real address; the page's own record documents are read
# from /api-static/ files by src/staticData.ts (no request leaves the site for them).
VITE_PC_API_BASE=https://pharmacycommons.org/api
# Day the static data was recorded from the local database (shown in the footer and on
# Developers, src/release.ts). Change it whenever static-data.tar.gz is re-recorded.
VITE_DATA_SNAPSHOT=2026-11-16
