# Local mode (`pnpm dev:local` → vite --mode localdb). Points the app at the local
# Supabase stack started with `supabase start` from this repo (see docs/local-app.md).
# These are the Supabase CLI's built-in local defaults, identical on every machine and
# useless outside 127.0.0.1, which is why this one .env file is committed.
# /supabase is proxied by the Vite dev/preview server to http://127.0.0.1:54321 (vite.config.ts)
VITE_SUPABASE_URL=/supabase
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
VITE_PC_API_BASE=/supabase/functions/v1/api
